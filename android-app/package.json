{
  "name": "forma-android",
  "private": true,
  "description": "Bọc index.html thành app Android bằng Capacitor",
  "scripts": {
    "web": "node copy-web.mjs",
    "sync": "node copy-web.mjs && cap sync android",
    "apk": "node copy-web.mjs && cap sync android && cd android && ./gradlew assembleDebug",
    "publish": "node publish-web.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@capgo/capacitor-updater": "^8.52.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
